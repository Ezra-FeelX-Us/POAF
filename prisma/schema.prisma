generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------
// NEXTAUTH & USERS (Admin & Member Portals)
// ----------------------------------------
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed for credentials
  role          String    @default("USER") // SUPER_ADMIN, ADMIN, DEPT_LEADER, PROJECT_MANAGER, TEAM_LEADER, MEMBER, USER

  memberId      String?   @unique // Link to public POAF Member profile
  member        Member?   @relation(fields: [memberId], references: [id])
  
  accounts      Account[]
  sessions      Session[]
  logs          ActivityLog[]
  applications  Application[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft Delete
}

// ----------------------------------------
// CORE ORGANIZATION
// ----------------------------------------
model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  
  members   Member[]
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  goals       String?
  
  leaderId    String?  @unique
  leader      Member?  @relation("DepartmentLeader", fields: [leaderId], references: [id])
  
  members     Member[] @relation("DepartmentMembers")
  projects    Project[]
  initiatives Initiative[]
  events      Event[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft Delete
}

model Member {
  id               String   @id @default(uuid())
  poafId           String?  @unique // e.g. POAF-MEM-0001
  firstName        String
  lastName         String
  email            String?  @unique
  photoUrl         String?
  bio              String?
  role             String   
  roles            String   @default("MEMBER") // Comma-separated: MEMBER,DEPARTMENT_LEADER,NATIONAL_AMBASSADOR,etc.
  membershipSource String   @default("USER_APPLICATION") // USER_APPLICATION or ADMIN_CREATED
  phone            String?
  school           String?
  gradeLevel       String?
  skills           String?  
  socialLinks      String?  
  status           String   @default("ACTIVE")

  isLeader         Boolean  @default(false)
  leaderPosition   String?  
  leaderOrder      Int?     
  leaderBio        String?  
  
  inviteCode       String?  @unique
  invitedBy        String?  
  inviteCount      Int      @default(0)

  // Grade Board & Operational Metrics
  totalPoints      Int      @default(0)
  gradeTier        String   @default("DISTINCTION") // DISTINCTION, HONORS, COMMENDED, ACTIVE
  tasksCompleted   Int      @default(0)

  displayOnMembersBoard     Boolean  @default(true)
  displayOnLeadershipBoard  Boolean  @default(false)
  displayOnHomepage         Boolean  @default(false)
  displayOnDepartmentRoster Boolean  @default(true)
  
  countryId        String
  country          Country  @relation(fields: [countryId], references: [id])
  
  departmentId     String?
  department       Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  ledDepartment    Department? @relation("DepartmentLeader")
  
  projectRoles     ProjectMember[]
  organizedEvents  Event[]     @relation("EventOrganizer")
  rsvps            RSVP[]
  assignedTasks    Task[]      @relation("AssignedTasks")
  reportedIssues   Issue[]     @relation("ReportedIssues")
  sentMessages     ProjectMessage[] @relation("SentMessages")
  initiativeRoles  InitiativeMember[]
  userAccount      User?

  joinedDate       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime? // Soft Delete
}

// ----------------------------------------
// PROJECTS & PROPOSALS
// ----------------------------------------
model Project {
  id            String   @id @default(uuid())
  poafId        String?  @unique // e.g. POAF-PRJ-0001
  title         String
  description   String
  problem       String?
  objective     String?
  methodology   String?
  expectedImpact String?
  results       String?

  status        String   @default("PROPOSED") 
  progressPct   Int      @default(0)
  
  category      String?  // e.g. Science & Engineering, Technology, Outreach
  projectType   String?  // e.g. Community Impact, Research Blueprint
  country       String?
  region        String?
  city          String?
  community     String?

  aim           String?
  needsAssessment String?
  riskManagement  String?
  sustainabilityPlan String?
  challenges      String?
  lessonsLearned  String?
  sdgs            String? // e.g. Quality Education, Clean Water, Innovation

  targetBeneficiaries Int?   // Planned
  actualBeneficiaries Int?   // Actual reached
  budget             Float? // Planned budget
  actualBudget       Float? // Actual expenditure
  poafFunding        Float?
  partnerFunding     Float?

  verifiedByAdmin    Boolean  @default(false)
  reportPdfUrl       String?
  
  startDate     DateTime?
  endDate       DateTime?

  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  
  teamMembers   ProjectMember[]
  documents     Document[]
  milestones    Milestone[]
  tasks         Task[]
  issues        Issue[]
  messages      ProjectMessage[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // Soft Delete
}

model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      String? 
  
  @@id([projectId, memberId])
}

model Milestone {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// ----------------------------------------
// INITIATIVES
// ----------------------------------------
model Initiative {
  id           String   @id @default(uuid())
  name         String
  description  String?
  status       String   @default("ACTIVE")
  goals        String?
  impact       String?
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  teamMembers  InitiativeMember[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // Soft Delete
}

model InitiativeMember {
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role         String?
  
  @@id([initiativeId, memberId])
}

// ----------------------------------------
// PARTNERSHIPS
// ----------------------------------------
model Partnership {
  id                 String   @id @default(uuid())
  poafId             String?  @unique // e.g. POAF-PTN-0001
  organizationName   String
  organizationType   String?
  logoUrl            String?
  description        String?
  collaborationAreas String?
  website            String?
  partnerSince       DateTime?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime? // Soft Delete
}

// ----------------------------------------
// NEWS & ANNOUNCEMENTS
// ----------------------------------------
model News {
  id          String   @id @default(uuid())
  title       String
  content     String
  coverImage  String?
  status      String   @default("DRAFT")
  publishedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft Delete
}

// ----------------------------------------
// DOCUMENTS
// ----------------------------------------
model Document {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String
  category    String   
  isPublic    Boolean  @default(true)
  
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft Delete
}

// ----------------------------------------
// ACTIVITY LOGS & AUDIT ENGINE
// ----------------------------------------
model ActivityLog {
  id           String   @id @default(uuid())
  action       String   // e.g. UPDATE_DEPARTMENT
  entityType   String?  // e.g. DEPARTMENT
  entityId     String?  // UUID of the affected row
  details      String?  
  previousData String?  // JSON representation of old state
  newData      String?  // JSON representation of new state
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
}

// ----------------------------------------
// APPLICATIONS (Tracking & Processing)
// ----------------------------------------
model Application {
  id        String   @id @default(uuid())
  poafId    String?  @unique // e.g. POAF-APP-0001
  type      String   // e.g. "MEMBERSHIP", "LEADERSHIP", "CHAPTER", "PARTNERSHIP"
  status    String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, REVISION_REQUIRED, ACCEPTED, REJECTED
  payload   String   // Stringified JSON of form data
  photoUrl  String?  // Reference photo if uploaded
  notes     String?  // Admin review notes
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft Delete
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}
// ----------------------------------------
// EVENTS & MEETINGS
// ----------------------------------------
model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  location    String?  // Could be physical or a Zoom/Meet link
  imageUrl    String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  organizerId  String
  organizer    Member      @relation("EventOrganizer", fields: [organizerId], references: [id])

  rsvps        RSVP[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model RSVP {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String   @default("ATTENDING") // ATTENDING, MAYBE, DECLINED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([eventId, memberId])
}
// ----------------------------------------
// PROJECT MANAGEMENT & OPERATIONAL TASK BOARD
// ----------------------------------------
model Task {
  id          String   @id @default(uuid())
  poafId      String?  @unique // e.g. POAF-TSK-0001
  title       String
  description String?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, SUBMITTED, GRADED, REVISION_REQUESTED, COMPLETED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  deadline    DateTime?
  
  departmentId String?  // Optional direct department task
  
  // Task Giver info (Leader / Admin)
  giverName   String?
  giverRole   String?
  
  // Grading & Evaluation
  maxPoints   Int      @default(100)
  awardedGrade Int?
  gradeFeedback String?
  
  // Member Work Submission
  submissionContent String?
  submissionLink    String?
  submittedAt       DateTime?
  
  // Reviewer info
  reviewedBy  String?
  reviewedAt  DateTime?

  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assigneeId  String?
  assignee    Member?  @relation("AssignedTasks", fields: [assigneeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model Issue {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  reporterId  String
  reporter    Member   @relation("ReportedIssues", fields: [reporterId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMessage {
  id          String   @id @default(uuid())
  content     String
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  senderId    String
  sender      Member   @relation("SentMessages", fields: [senderId], references: [id])

  createdAt   DateTime @default(now())
}

// ----------------------------------------
// COMMUNITY & DEPARTMENT CHAT CHANNELS
// ----------------------------------------
model ChatMessage {
  id           String   @id @default(uuid())
  channel      String   @default("GENERAL") // GENERAL, LEADERSHIP, or departmentId
  senderName   String
  senderRole   String?
  senderPhoto  String?
  senderPoafId String?
  content      String
  createdAt    DateTime @default(now())
}

// ----------------------------------------
// DEPARTMENT ANNOUNCEMENTS
// ----------------------------------------
model DepartmentAnnouncement {
  id           String   @id @default(uuid())
  departmentId String
  title        String
  content      String
  authorName   String
  authorRole   String?
  createdAt    DateTime @default(now())
}